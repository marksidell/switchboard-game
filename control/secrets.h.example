/* =============================================================================
 * secrets.h - broker address and credentials
 *
 * TEMPLATE. Copy to secrets.h and fill in; secrets.h is gitignored so a real
 * password cannot reach the remote:
 *
 *     cp control/secrets.h.example control/secrets.h
 *
 * mqtt.md 9: the broker is not anonymous. The firmware will build without these
 * filled in and simply fail to connect.
 * ========================================================================== */

#pragma once

#define MQTT_BROKER_HOST  "CHANGEME"   // hostname or IP of the Mosquitto host
#define MQTT_USERNAME     "CHANGEME"
#define MQTT_PASSWORD     "CHANGEME"

/* The client id the broker sees. One controller, so a fixed id is right: a
 * random one would leave an orphaned session behind on every reconnect. */
#define MQTT_CLIENT_ID    "sbgame-esp32"
