#!/bin/sh
# Put this checkout on the host and restart the game program.
#
#   ./release
#
# Installs the engine and the loader into /opt/sbgame/venv, script.yml and
# wav/ into /srv/sbgame, the page into /srv/sbgame/web, and the game
# program's configuration into /etc/sbgame/game.toml, then restarts sbgame
# and shows the start of its log.
#
# The configuration goes with the code because the two must agree: the game
# program refuses a setting it does not know, so a new key in game.toml needs
# the program that reads it, and is checked against it here.
#
# Everything, every time: the daemon runs its own installed copy of the
# loader, so a script.yml in a new form needs the new code alongside it, and
# installing what has not changed costs a few seconds. The installed script is
# checked before the restart (sbgame --check, in sbgame-install), so a script
# that does not load stops here and the running game program is left alone.
#
# The restart stops any game in progress; the page comes back to a stopped
# game. Needs sudo.
set -eu

cd "$(dirname "$0")"

make -C host sbgame-install
sudo install -o root -g root -m 644 host/etc/sbgame/game.toml /etc/sbgame/game.toml
sudo /opt/sbgame/venv/bin/sbgame --check -c /etc/sbgame/game.toml
make -C host sbgame-web
sudo systemctl restart sbgame

# Give it a moment to load the script and reach the broker.
sleep 2
systemctl is-active sbgame
journalctl -u sbgame --since "-10s" --no-pager -o cat
