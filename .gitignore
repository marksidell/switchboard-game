# Compiled bench tools. Sources are here; build them with the commands in CLAUDE.md.
/pilot_loopback_test
/tone_out
/tone_monitor

# Editing backups
*.bak

# Broker address and credentials. secrets.h.example is tracked and carries the
# placeholders; copy it to secrets.h and fill it in. The working copy is never
# committed, so a real password cannot reach the remote by accident.
/control/secrets.h

# Binaries arduino-cli exports into the sketch folder (build/<fqbn>/). Build
# output, regenerated by every compile; 26 MB of it was committed by mistake in
# 1b8bda2 and removed again in the next commit.
/control/build/
/control/sb_version.h

# The audio program's CMake build tree.
/audio/build/

# TTS pipeline. The venv and the generated audio are all reproducible; the
# chosen reference voices in tts/voices/*.wav are not — they cost Mark's ears —
# and are committed. tts_task.md section 8.
/tts/.venv/
/engine/.venv/
/tts/voices/candidates/
/tts/voices/preview/
/tts/raw/
# tts/scenes --batch output
/mp3/
/tts/jobs.json

# Python bytecode, and the metadata an editable install leaves behind.
__pycache__/
*.egg-info/
/engine/sbgame.egg-info/

# What a non-editable pip install (make -C host sbgame-install) leaves behind.
/tts/build/
/engine/build/

# KiCad. The projects and lib/ are tracked; what KiCad writes beside them is not.
# Gerbers and the fab zips are plot output, regenerated from the .kicad_pcb.
/kicad/**/*-backups/
/kicad/**/gerbers/
/kicad/**/*.zip
/kicad/**/~*.lck
/kicad/**/fp-info-cache
/kicad/**/#auto_saved_files#
/kicad/**/_autosave-*
# Per-user view state (layers, zoom), rewritten on every open; and the ERC report,
# regenerated by every check.
/kicad/**/*.kicad_prl
/kicad/**/*.rpt
