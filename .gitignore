# Editing backups
*.bak

# Broker address and credentials. secrets.h.example is tracked and carries the
# placeholders; copy it to secrets.h and fill it in. The working copy is never
# committed, so a real password cannot reach the remote by accident.
/esp32/secrets.h

# Binaries arduino-cli exports into the sketch folder (build/<fqbn>/). Build
# output, regenerated by every compile; 26 MB of it was committed by mistake in
# 1b8bda2 and removed again in the next commit.
/esp32/build/

# The audio program's CMake build tree.
/audio/build/
