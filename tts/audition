#!/usr/bin/env python3
"""Audition the candidate voices and record the choices (tts_task.md 5.4).

Walks the cast in script order. For each person it prints who they are, plays
the three candidates through the Digiface's headphone jack, and asks which one
to keep. The answer goes straight into tts/voices.yml, so stopping half way
loses nothing and running again picks up where it left off.

Plays the band-limited previews by default, not the raw candidates: the
telephone band is how the audience hears these, and a voice that is lovely at
full bandwidth can disappear at 3.4kHz. --raw is there for comparison, not for
choosing.

Audio path, from docs/audio-io.md: the Digiface USB, found by name
(tts/playback.py), with 34 playback channels of S32_LE at 48kHz, and the
headphone jack is the last pair, zero-based indices 32 and 33. So each clip is
placed into a 34-channel frame with silence everywhere else and handed to aplay.
"""

from __future__ import annotations

import argparse
import os
import subprocess
import sys
from pathlib import Path

# Run under the project venv whatever interpreter started this. A shebang
# cannot name a path relative to the repo, so `tts/audition` from a shell gets
# the system python, which has none of the dependencies; re-exec once, and
# only when not already inside a venv.
_venv = Path(__file__).resolve().parent / ".venv" / "bin" / "python"
if sys.prefix == sys.base_prefix and _venv.exists():
    os.execv(str(_venv), [str(_venv), str(Path(__file__).resolve()), *sys.argv[1:]])

sys.path.insert(0, str(Path(__file__).resolve().parent.parent))

from tts.prompt import sample_text, voice_prompt          # noqa: E402
from tts.script import DEFAULT_SCRIPT, ScriptError, load  # noqa: E402
from tts.playback import MAX_CIRCUIT, PHONES, digiface, out_channels, play  # noqa: E402


PREVIEW = Path("tts/voices/preview")
CANDIDATES = Path("tts/voices/candidates")
CHOICES = Path("tts/voices.yml")


def read_choices(path: Path) -> dict[str, int]:
    if not path.exists():
        return {}
    from ruamel.yaml import YAML
    yaml = YAML(typ="safe")
    yaml.allow_duplicate_keys = False
    return {str(k): int(v) for k, v in (yaml.load(path.read_text(encoding="utf-8")) or {}).items()}


def write_choices(path: Path, choices: dict[str, int], order: list[str]) -> None:
    lines = ["# Which candidate to keep for each cast member (tts_task.md 5.4).",
             "# Written by tts/audition; tts/choose reads it.", ""]
    for person in order:
        if person in choices:
            lines.append(f"{person}: {choices[person]}")
    path.write_text("\n".join(lines) + "\n", encoding="utf-8")


def main() -> int:
    p = argparse.ArgumentParser(description=__doc__.splitlines()[0])
    p.add_argument("--script", default=DEFAULT_SCRIPT)
    p.add_argument("--from", dest="src", type=Path, default=PREVIEW,
                   help=f"directory of clips to play (default {PREVIEW})")
    p.add_argument("--raw", action="store_true",
                   help=f"play {CANDIDATES} at full bandwidth instead of the previews")
    p.add_argument("--choices", type=Path, default=CHOICES)
    p.add_argument("--device", help="ALSA playback device (default: the Digiface, found by name)")
    # docs/audio-io.md: the bench tools disagree on this deliberately, and
    # tone_out takes one-based numbers. Match tone_out, and print both, so the
    # pin in use is never in doubt.
    p.add_argument("--channel", type=int, metavar="N",
                   help=f"send to one circuit, 1..{MAX_CIRCUIT} one-based "
                        f"(0..{MAX_CIRCUIT - 1} as the driver indexes it). "
                        f"Default is the headphone jack, 33/34.")
    p.add_argument("--gain", type=float, default=0.0, help="dB, applied on the way out")
    p.add_argument("--only", default="", help="comma-separated cast keys")
    p.add_argument("--all", action="store_true",
                   help="include people already chosen, rather than resuming")
    args = p.parse_args()

    try:
        channels = out_channels(args.channel)
    except ValueError as e:
        print(e, file=sys.stderr)
        return 1

    src = CANDIDATES if args.raw else args.src
    try:
        script = load(args.script)
    except ScriptError as e:
        print(f"{e.path}: {len(e.failures)} problem(s)", file=sys.stderr)
        for f in e.failures:
            print(f"  {f}", file=sys.stderr)
        return 1

    order = list(script.cast)
    choices = read_choices(args.choices)
    wanted = [w for w in args.only.split(",") if w] or order
    unknown = [w for w in wanted if w not in script.cast]
    if unknown:
        print(f"not in the cast: {', '.join(unknown)}", file=sys.stderr)
        return 1
    queue = [w for w in wanted if args.all or args.only or w not in choices]

    device = digiface(args.device)
    where = ("the headphone jack, channels 33/34 (0-based indices 32/33)"
             if channels == PHONES else
             f"channel {channels[0] + 1} (0-based index {channels[0]})")
    print(f"playing {src}/ through {device}, {where}")
    if not args.raw:
        print("these are the band-limited previews — 300-3400Hz, as the audience hears them")
    if len(queue) < len(wanted):
        print(f"{len(wanted) - len(queue)} already chosen; --all to revisit them")
    print(f"{len(queue)} to audition\n")

    i = 0
    while i < len(queue):
        person = queue[i]
        entry = script.cast[person]
        lines = script.first_lines(person)
        text, _used = sample_text(script, person)

        print("=" * 72)
        print(f"{person} — {entry.get('description', '(no description)')}")
        print(f"  {entry.get('sex', '?')}, {entry.get('accent', '?')}"
              f"   ({i + 1} of {len(queue)}, {len(lines)} lines in the script)")
        print(f'  says: "{text}"')
        if person in choices:
            print(f"  currently chosen: {choices[person]}")
        print()

        # However many takes there are: three by default, more when a person
        # has been designed again with tts/aws/design --takes N.
        available = sorted(int(p.stem.rsplit(".", 1)[1]) for p in src.glob(f"{person}.*.wav")
                           if p.stem.rsplit(".", 1)[1].isdigit())
        if not available:
            print(f"  no clips for {person} in {src}/ — skipping")
            i += 1
            continue

        def play_all() -> None:
            for k in available:
                print(f"  [{k}] …", end="", flush=True)
                play(src / f"{person}.{k}.wav", device, args.gain, channels)
                print(" done")

        play_all()

        while True:
            answer = input(f"\n  {person}: [1-{max(available)}] keep  [r] all again  "
                           f"[p<n>] play one  [s] skip  [b] back  [q] quit > ").strip().lower()
            if answer in {str(k) for k in available}:
                choices[person] = int(answer)
                write_choices(args.choices, choices, order)
                print(f"  {person}: {answer}  (saved)")
                i += 1
                break
            if answer == "r":
                play_all()
                continue
            if answer.startswith("p") and answer[1:].isdigit() and int(answer[1:]) in available:
                k = int(answer[1:])
                print(f"  [{k}] …", end="", flush=True)
                play(src / f"{person}.{k}.wav", device, args.gain, channels)
                print(" done")
                continue
            if answer == "s":
                print(f"  {person}: skipped")
                i += 1
                break
            if answer == "b":
                i = max(0, i - 1)
                break
            if answer == "q":
                write_choices(args.choices, choices, order)
                missing = [c for c in script.cast if c not in choices]
                print(f"\n{len(choices)} of {len(script.cast)} chosen, written to {args.choices}")
                if missing:
                    print(f"still to do: {', '.join(missing)}")
                return 0
            print(f"  '{answer}'? one of {'/'.join(str(k) for k in available)}, r, p<n>, s, b, q")

    write_choices(args.choices, choices, order)
    missing = [c for c in script.cast if c not in choices]
    print(f"\n{len(choices)} of {len(script.cast)} chosen, written to {args.choices}")
    if missing:
        print(f"still to do: {', '.join(missing)}")
    else:
        print("all chosen — next is tts/choose, then tts/aws/generate")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
