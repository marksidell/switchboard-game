#!/usr/bin/env python3
"""Render the ring cue (game_control.md §6.6, Rev 51) to wav/cue.ringback.wav.

The audience loudspeaker plays it while a station reports ring, so the room
hears the operator ringing. It is the period ringback of audio.md §8.2 — the
city ring measured from a recording, Rev 21, whose partials are read from
audio/src/cityring.h so the trunks and the loudspeaker sound the same — but
steady, with no cadence: it follows the operator's ringing key, not an
office's interrupter.
A tone, not speech, so it is made here rather than by the TTS run, and
tts/process leaves `cue.*` out of its check for files in no scene.

48kHz mono 24-bit, as sbaudio wants (audio.md §7.2). Its RMS is set a few dB
under the speech files' (about -21 to -26dBFS), so it sits under the calls
and the tutor at the monitor's one file trim.

    tts/cue                 # writes wav/cue.ringback.wav
    tts/cue --rms -30       # quieter
"""

from __future__ import annotations

import argparse
import math
import re
import wave
from pathlib import Path

RATE = 48000
CITY_RING = Path(__file__).resolve().parent.parent / "audio" / "src" / "cityring.h"
PERIOD = RATE // 20                       # one period of the city ring, 20Hz
EDGE = 0.010                              # s of raised-cosine fade each end


def partials() -> list[tuple[int, float, float]]:
    """cityring.h's rows: harmonic of 20Hz, amplitude, phase."""
    row = re.compile(r"^\s*\{\s*(\d+),\s*([0-9.]+)f,\s*([-+0-9.]+)f\s*\},", re.M)
    out = [(int(n), float(a), float(p)) for n, a, p in row.findall(CITY_RING.read_text())]
    if not out:
        raise SystemExit(f"{CITY_RING}: no partials found")
    return out


def render(seconds: float, rms_db: float) -> tuple[bytes, float]:
    rows = partials()
    one = [sum(a * math.cos(2 * math.pi * n * 20 * i / RATE + p) for n, a, p in rows)
           for i in range(PERIOD)]
    rms = math.sqrt(sum(v * v for v in one) / PERIOD)
    amp = 10 ** (rms_db / 20) / rms
    n = int(seconds * RATE)
    edge = int(EDGE * RATE)
    out = bytearray()
    for i in range(n):
        x = amp * one[i % PERIOD]
        k = min(i, n - 1 - i)
        if k < edge:
            x *= 0.5 - 0.5 * math.cos(math.pi * k / edge)
        out += int(round(x * (2 ** 23 - 1))).to_bytes(3, "little", signed=True)
    return bytes(out), 20 * math.log10(amp * max(abs(v) for v in one))


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--rms", type=float, default=-28.0, help="dBFS RMS (default -28)")
    ap.add_argument("--seconds", type=float, default=60.0,
                    help="length; longer than any ring the operator holds (default 60)")
    ap.add_argument("--out", type=Path,
                    default=Path(__file__).resolve().parent.parent / "wav" / "cue.ringback.wav")
    a = ap.parse_args()
    with wave.open(str(a.out), "wb") as w:
        w.setnchannels(1)
        w.setsampwidth(3)
        w.setframerate(RATE)
        frames, peak = render(a.seconds, a.rms)
        w.writeframes(frames)
    print(f"{a.out}: {a.seconds:g}s, {a.rms:g}dBFS RMS, peak {peak:.1f}dBFS")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
