#!/usr/bin/env bash
# Session 2 (tts_task.md 6): speak every line that needs speaking.
#
# What needs generating is decided here, before anything is launched, so an
# instance is only started if there is work — and so a run that regenerates one
# line costs one line's worth of GPU, not the whole script's.
set -euo pipefail
cd "$(dirname "$0")"
. ./common.sh
. ./session.sh

# Only one session at a time. teardown terminates every instance tagged
# project=sbgame-tts rather than just this run's, which is right — a session
# that died badly must not leave a GPU behind — but it means two overlapping
# runs kill each other's instance.
exec 9>"${TMPDIR:-/tmp}/sbgame-tts.lock"
flock -n 9 || die "another sbgame-tts session is running (or its teardown has not finished). \
Wait for it, or check tts/aws/status."

REPO=$(cd ../.. && pwd)
SCRIPT_YML=${SCRIPT_YML:-$REPO/script.yml}
PY=$REPO/tts/.venv/bin/python
[ -x "$PY" ] || PY=python3
RAW=$REPO/tts/raw
JOBS=$REPO/tts/jobs.json
INSTANCE_TYPE=${INSTANCE_TYPE:-g6.xlarge}
ONLY=""; KEEP=0; BATCH=1; DRY=0; PUBLIC=""

while [ $# -gt 0 ]; do
    case $1 in
        --only)  ONLY=$2; shift 2 ;;
        --batch) BATCH=$2; shift 2 ;;
        --type)  INSTANCE_TYPE=$2; shift 2 ;;
        --keep)  KEEP=1; shift ;;
        --dry)   DRY=1; shift ;;     # plan only; launch nothing
        --public) PUBLIC=--public; shift ;;   # no private voices (tts_task.md 5.1)
        *) die "unknown option: $1" ;;
    esac
done

[ -f "$KEY_FILE" ] || die "no private key at $KEY_FILE"
[ -d "$REPO/tts/voices" ] || die "no reference voices; run tts/aws/design and tts/choose first"

echo "=== planning (6.3) ==="
cd "$REPO"
"$PY" -m tts.manifest --script "$SCRIPT_YML" --write-jobs "$JOBS" ${ONLY:+--only "$ONLY"} $PUBLIC
cd "$(dirname "$0")"
count=$("$PY" -c 'import json,sys; print(len(json.load(open(sys.argv[1]))))' "$JOBS")
[ "$count" = 0 ] && { echo "nothing to generate — every line is up to date"; exit 0; }
[ "$DRY" = 1 ] && { echo "--dry: $count line(s) would be generated; not launching"; exit 0; }

INSTANCE_ID=""; PUBLIC_IP=""
STARTED=$(date +%s)

teardown() {
    local rc=$?
    set +e
    if [ "$KEEP" = 1 ] && [ -n "$INSTANCE_ID" ] && [ "$rc" = 0 ]; then
        printf '\n--keep: leaving %s running. It self-terminates %s minutes after boot.\n' "$INSTANCE_ID" "$SELF_TERMINATE_MIN"
        printf '  ssh -i %s ubuntu@%s\n  tts/aws/teardown when finished\n' "$KEY_FILE" "$PUBLIC_IP"
        exit $rc
    fi
    printf '\n=== teardown (exit %s, %s elapsed) ===\n' "$rc" "$(elapsed_since "@$STARTED")"
    ./teardown
    exit $rc
}
trap teardown EXIT INT TERM

echo "=== image ==="
pick_image
echo "=== ssh rule for today's address ==="
open_ssh_today
echo "=== launch ($count line(s) to generate) ==="
launch_tagged sbgame-tts-generate
echo "=== the guard that cannot be dry-run before launch (4.4) ==="
assert_can_terminate
echo "=== waiting for it ==="
wait_for_ssh

echo "=== uploading ==="
upload_tree "$REPO"
rsync -az -e "$SSH" "$JOBS" ubuntu@"$PUBLIC_IP":~/jobs.json
# The chosen references only. upload_tree has just sent them, under ~/tts, so
# they are copied over there rather than sent again; the audition files,
# voices/candidates and voices/preview (274 MB), are never needed on the
# instance, and sending them took 20 minutes a run on a home uplink.
$SSH ubuntu@"$PUBLIC_IP" "mkdir -p ~/voices && cp ~/tts/voices/*.wav ~/tts/voices/*.json ~/voices/"
[ -z "$PUBLIC" ] && [ -d "$REPO/private/voices" ] && \
    rsync -az -e "$SSH" "$REPO/private/voices/" ubuntu@"$PUBLIC_IP":~/voices/
[ "$FROM_BAKED" = 0 ] && { echo "=== setup ==="; run_setup; }

echo "=== generating ==="
$SSH ubuntu@"$PUBLIC_IP" "~/tts-venv/bin/python ~/tts/remote/generate_lines.py \
    --jobs ~/jobs.json --voices ~/voices --out ~/raw --batch $BATCH"

echo "=== copying back ==="
rm -rf "$RAW/incoming"; mkdir -p "$RAW/incoming"
rsync -az -e "$SSH" ubuntu@"$PUBLIC_IP":~/raw/ "$RAW/incoming/"

echo "=== recording what was made (6.3) ==="
cd "$REPO" && "$PY" -m tts.manifest --record "$JOBS" --raw "$RAW/incoming" $PUBLIC || true
cd "$(dirname "$0")"
echo
echo "Now run the local step, which needs no GPU:"
echo "  tts/.venv/bin/python -m tts.process $PUBLIC"
