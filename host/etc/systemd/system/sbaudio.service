# sbaudio - the 551 switchboard simulator's audio program.
#
# Installed by `make -C host install`, with the rest of the host's files; the
# program itself by the steps in audio/README.md. Every level in ExecStart is a
# bench setting (audio.md 14, 15): the defaults in the program are the figures
# station 8 gives, and what the bench says goes here rather than into the source.

[Unit]
Description=551 switchboard simulator audio program
Documentation=file:///home/sidell/s/sbgame/audio/README.md
# The broker is not a hard dependency: audio.md 13.1 starts the stream before
# MQTT on purpose, because the pilots and the operator tone are part of the
# switchboard's electrical environment and nothing about them needs a broker.
After=sound.target mosquitto.service
Wants=mosquitto.service

[Service]
Type=exec
User=sidell
SupplementaryGroups=audio
WorkingDirectory=/home/sidell/s/sbgame

ExecStart=/usr/local/bin/sbaudio \
    --card USB24306452 \
    --period 256 --periods 3 \
    --broker localhost:1883 \
    --mqtt-user sbgame-audio --mqtt-pass-file /etc/sbgame/mqtt-audio.pass \
    --wav-dir /home/sidell/s/sbgame/wav \
    --record-dir /srv/sbgame/recordings \
    --monitor 0 \
    --monitor-ch 33 \
    --monitor-file-trim -18 \
    --monitor-limit -18 \
    --monitor-gate -70 \
    --vad-floor -70

# audio.md 13.2: there is no attempt to run without audio. An unrecoverable
# stream failure exits non-zero, systemd brings the program back, and the
# birth/LWT sequence tells the game what happened.
Restart=on-failure
RestartSec=2

# SCHED_FIFO and mlockall, without which the program logs and continues at the
# cost of xruns (audio.md 14). These are what limits.conf or rtkit would
# otherwise have to provide.
LimitRTPRIO=95
LimitMEMLOCK=infinity

# FFTW's plan cache (audio.md 14). ProtectHome=read-only below makes the
# program's ~/.cache default unwritable, so the cache is a service fact
# instead: systemd creates /var/lib/sbaudio, owned by User=, before start.
StateDirectory=sbaudio
Environment=SBAUDIO_WISDOM=/var/lib/sbaudio/wisdom

# stdout is the --dump CSV and is empty in service use; stderr is the log.
StandardOutput=null
StandardError=journal

NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ProtectControlGroups=true
ProtectKernelTunables=true
RestrictRealtime=false
# The sound devices have to stay reachable through the hardening above.
DeviceAllow=char-alsa rw

[Install]
WantedBy=multi-user.target
