# 551 Switchboard Simulator status page. game_control.md 2, mqtt.md 9.
#
# nginx terminates TLS for game.kr3am.org on 443, serves the page's files, and
# reverse-proxies the page's MQTT socket to Mosquitto's loopback WebSockets
# listener. Mosquitto served both itself through mqtt.md Rev 16; on this host it
# could not hold 443 (libwebsockets creates its socket after the privilege drop)
# and it advertised HTTP/2 without being able to speak it.
#
# One origin and one port, so the bookmark carries no port and the page's
# wss:// URL is location.host with the /mqtt path.

map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# Plain HTTP, only to send the browser to TLS.
#
# Not for the certificate: that is issued by DNS-01 through Route 53, so no
# ACME challenge ever comes here. It is for the address bar and the bookmark.
# With no listener on 80 at all, a request for `game.kr3am.org` typed without a
# scheme - or a Home Screen icon saved from one - is refused at the TCP level,
# and the browser can only report that the site cannot be reached. A desktop
# browser hides this after its first successful https:// visit, because it then
# remembers to upgrade the host; a device visiting for the first time does not,
# which is how one machine can work and another appear to have no route at all.
#
# 301 rather than 302: it is permanent, and a permanent redirect is what teaches
# the browser to stop asking for http next time.
server {
    listen 80;
    listen [::]:80;
    server_name game.kr3am.org;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name game.kr3am.org;

    ssl_certificate     /etc/letsencrypt/live/game.kr3am.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/game.kr3am.org/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;

    root /srv/sbgame/web;
    index index.html;

    # The page's MQTT connection. Routed by path rather than by the Upgrade
    # header, because an `if` inside a location is documented as fragile.
    #
    # `location = /mqtt` is an exact match, deliberately. A prefix match would
    # also catch /mqtt.min.js — the page's own copy of MQTT.js — and proxy it
    # to Mosquitto, which is not a web server: 502, and a page that loads with
    # its library missing.
    location = /mqtt {
        proxy_pass http://127.0.0.1:9001;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_set_header Host $host;
        # A game can sit idle between calls; don't drop the socket for it.
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }

    # A service worker is only allowed to control pages at or below its own
    # path, and a cached one is the one thing that can outlive a deploy: the
    # browser re-fetches it, and a stale copy keeps serving the old shell.
    location = /sw.js {
        add_header Cache-Control "no-cache";
        try_files $uri =404;
    }

    # .webmanifest is not in nginx's mime.types, so it needs a type of its own.
    # NOT a `types { }` block here: that REPLACES the inherited map outright
    # rather than adding to it, and every other file — html, css, js, png —
    # then goes out as application/octet-stream. The page does not render and
    # the service worker is refused, because a worker must be served with a
    # JavaScript type.
    location = /manifest.webmanifest {
        default_type application/manifest+json;
    }

    location / {
        try_files $uri $uri/ =404;
    }
}
