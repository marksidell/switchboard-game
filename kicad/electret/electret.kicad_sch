	(text "J1 to the switchboard transmitter feed, either polarity.  J2 to the capsule in the mouthpiece (Same Sky CMC-97452-L100, unidirectional, rear port open), + to pin 1, the lead with continuity to the can to pin 2."
		(exclude_from_sim no)
		(at 20.32 27.94 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "17710bc0-7c88-4ea8-95b2-b090d702029c")
	)
	(text "U1A gain 1 + R10/R11, 72 Hz (R11 C8) – 3.4 kHz (R10 C7).  R11 selected on the bench, 4k7–6k8, for headroom on OUT.  Tested with R11 4k7, C8 470n; C8 220n would restore the 150 Hz corner, untested."
		(exclude_from_sim no)
		(at 20.32 33.528 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "5bbb26f2-c4f2-484c-a763-e7a83d6c9639")
	)
	(text "Carbon transmitter replacement — electret capsule, board in a box on the headset cord"
		(exclude_from_sim no)
		(at 20.32 22.86 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "6219e8ab-7c08-45bb-817c-d5af66bc5bef")
	)
	(text "U1B unused: follower on VREF."
		(exclude_from_sim no)
		(at 259.08 48.26 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "85fe5768-c85f-48e0-b7f6-aa56ea865d89")
	)
	(text "Q1 (TIP120 Darlington) R2 R3: Vbe multiplier, COLL-GND ≈ 3.5 V.  Feed is 24 V through the 140 Ω retard coil: ≈ 120 mA, ≈ 6.3 V across J1, ≈ 0.75 W in the box.  Speech enters at BASE through R12: ΔV = −(R2/R12)·v(OUT).  R1 10–22 Ω, by sidetone."
		(exclude_from_sim no)
		(at 20.066 40.132 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "9fc7eaa3-2a50-4985-ac5e-ec480dde7a5b")
	)
	(text "300 Hz–3 kHz within ±1 dB, −2 dB at 3.4 kHz, ≥ 39 dB from 6.0 to 9.14 kHz; L ±10 %, C ±5 %: ≥ 30 dB in 99 % of trials."
		(exclude_from_sim no)
		(at 88.9 160.02 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "daafb1b5-fabd-4cd7-aaca-e8b99ba4030a")
	)
	(text "Notches 8.06 kHz (L1 C9) and 6.10 kHz (L2 C11).  Simulated against kicad/electret/measurements (receiver on the ear, source through a 500 set):"
		(exclude_from_sim no)
		(at 88.9 156.21 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "dca07521-85e8-4ee6-9a81-a76da613c7f3")
	)
	(text "Two-stage supply filter: the A node carries the output signal; one stage would let it back into the capsule."
		(exclude_from_sim no)
		(at 59.182 110.236 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "ea4fa3ad-e35d-4bec-80ef-54f2b6794e2c")
	)
	(text "Receiver low-pass, in the box on the receiver pair: elliptic, series element first so it does not load the cord at pilot frequencies."
		(exclude_from_sim no)
		(at 88.9 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "f81170fb-0b78-403d-a60b-81ca928ae1af")
	)
